# Auto-generated example syntax for the Webserv project reviewed with this tester.
# Installed configuration is rendered by: python3 webserv_tester.py --setup
# All SITE/PYTHON placeholders are replaced with paths on the current machine.
server {
    listen 127.0.0.1:{{PORT}};
    root {{SITE}}/www;
    client_max_body_size 10M;
    error_page 404 /errors/404.html;

    location / {
        methods GET;
        index index.html;
        directory_listing off;
    }
    location /listing {
        methods GET;
        root {{SITE}}/www/listing;
        directory_listing on;
    }
    location /empty {
        methods GET;
        root {{SITE}}/www/empty;
        directory_listing off;
    }
    location /redirect {
        methods GET;
        redirect 301 /index.html;
    }
    location /cgi-bin {
        methods GET POST;
        root {{SITE}}/www/cgi-bin;
        cgi .py {{PYTHON}};
    }
    location /post_body {
        methods POST;
    }
    location /upload {
        methods POST;
        upload on;
        upload_store {{SITE}}/www/uploads;
    }
    location /uploads {
        methods GET DELETE;
        root {{SITE}}/www/uploads;
        upload on;
        upload_store {{SITE}}/www/uploads;
    }
    location /limited {
        methods POST;
        client_max_body_size 1000;
    }
}
server {
    listen 127.0.0.1:{{PORT2}};
    root {{SITE}}/second_www;
    location / {
        methods GET;
        index index.html;
        directory_listing off;
    }
}
